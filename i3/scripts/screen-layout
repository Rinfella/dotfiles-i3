#!/usr/bin/env bash

# CONFIGURATION
LAYOUT_DIR="$HOME/.screenlayout"
ROFI_THEME="$HOME/.config/rofi/screen-layout.rasi"
WALLPAPER_CMD="feh --randomize --bg-fill $HOME/Pictures/wallpapers/*.png"

# Arrays
declare -a file_list
declare -a display_list
max_str_len=0

# Check directory
if [ ! -d "$LAYOUT_DIR" ]; then
    notify-send -u critical "Error" "Layout directory $LAYOUT_DIR not found!" 
    exit 1
fi

# Preferred layout ordering: "key:icon:Custom Display Title"
ORDERED_LAYOUTS=(
    "autodetect:󰑐:Auto Detect"
    "triple-extended:󰍺:Triple Screen (DP Portrait)"
    "triple-landscape:󰍺:Triple Screen (DP Landscape)"
    "dual-external:󰍹:Dual External (DP Portrait)"
    "dual-landscape:󰍹:Dual External (DP Landscape)"
    "mirror::Mirror All Displays"
    "extended-right:➡:Extended Right (HDMI)"
    "extended-up:⬆:Extended Up (HDMI)"
    "extended-left:⬅:Extended Left (HDMI)"
    "single::Single (Laptop Only)"
    "hdmi-only:󰍹:HDMI Only"
    "dp-extended-right:󰡁:DP Extended Right"
    "dp-only:󰡁:DP Only"
)

declare -A processed

# Add items in preferred order if their script exists
for item in "${ORDERED_LAYOUTS[@]}"; do
    IFS=":" read -r key icon title <<< "$item"
    if [[ "$key" == "autodetect" ]]; then
        script="$HOME/.config/i3/scripts/autodetect-display"
    else
        script="$LAYOUT_DIR/${key}.sh"
    fi

    if [[ -x "$script" ]]; then
        display_str="$icon  $title"
        file_list+=("$script")
        display_list+=("$display_str")
        processed["$key"]=1
        if (( ${#display_str} > max_str_len )); then
            max_str_len=${#display_str}
        fi
    fi
done

# SCAN LOOP for any additional scripts in LAYOUT_DIR not in preferred list
for file in "$LAYOUT_DIR"/*.sh; do
    [ -f "$file" ] || continue
    filename=$(basename "$file" .sh)
    [[ -n "${processed[$filename]}" ]] && continue
    
    # Icon Logic (converted filename to lowercase for easier matching)
    case "${filename,,}" in
        *"triple"*)             icon="󰍺" ;;
        *"dual"*)               icon="󰍹" ;;
        *"up"*)                 icon="⬆" ;;
        *"down"*)               icon="⬇" ;;
        *"left"*)               icon="⬅" ;;
        *"right"*)              icon="➡" ;;
        *"mirror"*)             icon="" ;;
        *"laptop"*|*"internal"*)icon="" ;; # Laptop icon
        *"hdmi"*|*"external"*|*"dp"*) icon="󰍹" ;; # External Monitor icon
        *"single"*)             icon="" ;;
        *)                      icon="" ;;
    esac

    # Name Formatting (Title Case, no hyphens)
    clean_name="${filename//[-_]/ }"
    clean_name=${clean_name^}

    # Display String (Icon + Name Only)
    display_str="$icon  $clean_name"

    if (( ${#display_str} > max_str_len )); then
        max_str_len=${#display_str}
    fi

    file_list+=("$file")
    display_list+=("$display_str")
done

# Cancel Button
display_list+=("  Cancel")
line_count=${#display_list[@]}

# Calculate width based on longest display String (added +4ch for padding)
calculated_width="$(( max_str_len + 4 ))ch"

# ROFI EXECUTION
selected_index=$(printf "%s\n" "${display_list[@]}" | ROFI_WIDTH="$calculated_width" ROFI_LINES="$line_count" rofi -dmenu -i -theme "$ROFI_THEME" -lines "$line_count" -p "Layout" -format i)

# Exit if nothing selected or if "Cancel" is chosen
if [ -z "$selected_index" ] || [ "$selected_index" -eq $((line_count - 1)) ]; then
    exit 0
fi

# APPLY SELECTION
target_script="${file_list[$selected_index]}"
    
if [ -x "$target_script" ]; then
    "$target_script"
    eval "$WALLPAPER_CMD"
    i3-msg restart
    notify-send "Display Layout" "Applied: $(basename "$target_script" .sh)" -i video-display
fi
