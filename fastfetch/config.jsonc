// Catppuccin Mocha Minimal Clean Fastfetch with Kitty Image Protocol
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/assets/arch.png",
        "width": 16,
        "height": 8,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[1;38;2;203;166;247mrf\u001b[0m\u001b[38;2;108;112;134m@\u001b[0m\u001b[1;38;2;137;180;250mT14-Gen1\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;69;71;90m────────────────────────\u001b[0m"
        },
        {
            "key": " wm",
            "type": "wm",
            "format": "{1}",
            "keyColor": "35"
        },
        {
            "key": " up",
            "type": "uptime",
            "format": "{2}h {3}m",
            "keyColor": "32"
        },
        {
            "key": "󰌽 kernel",
            "type": "kernel",
            "format": "{1} {2}",
            "keyColor": "34"
        },
        {
            "key": "󰍛 cpu",
            "type": "cpu",
            "format": "{1}",
            "keyColor": "33"
        },
        {
            "key": " mem",
            "type": "memory",
            "format": "{1} / {2} ({3})",
            "keyColor": "36"
        },
        {
            "key": "󰉉 disk",
            "type": "disk",
            "folders": "/",
            "format": "{1} / {2} ({3})",
            "keyColor": "31"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "padding": {
                "top": 1
            }
        }
    ]
}