// Catppuccin Mocha Fastfetch
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "key": {
            "width": 14
        }
    },
    "modules": [
        {
            "key": " user",
            "type": "title",
            "format": "{user-name}",
            "keyColor": "35"
        },
        {
            "key": "󰇅 host",
            "type": "title",
            "format": "{host-name}",
            "keyColor": "34"
        },
        {
            "key": "󰅐 uptime",
            "type": "uptime",
            "keyColor": "33"
        },
        {
            "key": "󰣇 distro",
            "type": "os",
            "keyColor": "36"
        },
        {
            "key": " kernel",
            "type": "kernel",
            "keyColor": "32"
        },
        {
            "key": " wm",
            "type": "wm",
            "keyColor": "35"
        },
        {
            "key": " term",
            "type": "terminal",
            "keyColor": "34"
        },
        {
            "key": " shell",
            "type": "shell",
            "keyColor": "33"
        },
        {
            "key": "󰍛 cpu",
            "type": "cpu",
            "showPeCoreCount": true,
            "keyColor": "31"
        },
        {
            "key": "󰉉 disk",
            "type": "disk",
            "folders": "/",
            "keyColor": "32"
        },
        {
            "key": " memory",
            "type": "memory",
            "keyColor": "36"
        },
        {
            "key": "󰩟 network",
            "type": "localip",
            "format": "{ipv4} ({ifname})",
            "keyColor": "35"
        },
        {
            "key": " colors",
            "type": "colors",
            "symbol": "diamond",
            "keyColor": "34"
        }
    ]
}
